# Python caches
__pycache__/
*.py[cod]

# Simulation outputs
sim/build/
*.vcd
*.vvp

# Vivado generated files and build products
*.jou
*.log
*.pb
*.str
*.wdb
*.wdf
*.dcp
FPGA/FPGA.cache/
FPGA/FPGA.hw/
FPGA/FPGA.ip_user_files/
FPGA/FPGA.runs/
FPGA/FPGA.sim/
.Xil/
FPGA/.Xil/
vitis_workspace/

# Generated Block Design output; keep the checked-in system.bd only.
FPGA/FPGA.srcs/sources_1/bd/mref/
FPGA/FPGA.srcs/sources_1/bd/system/hdl/
FPGA/FPGA.srcs/sources_1/bd/system/hw_handoff/
FPGA/FPGA.srcs/sources_1/bd/system/ip/
FPGA/FPGA.srcs/sources_1/bd/system/ipshared/
FPGA/FPGA.srcs/sources_1/bd/system/sim/
FPGA/FPGA.srcs/sources_1/bd/system/synth/
FPGA/FPGA.srcs/sources_1/bd/system/ui/
FPGA/FPGA.srcs/sources_1/bd/system/*.bxml
FPGA/FPGA.srcs/sources_1/bd/system/*_ooc.xdc

# Candidate and diagnostic products created by rebuild/report scripts
artifacts/candidate_dma_batch/
artifacts/experimental_failed/
reports/experimental_failed/
reports/candidate_dma_batch/
reports/*_render*/

# Keep only the reproducible IP configuration from generated IP source trees.
FPGA/FPGA.srcs/sources_1/ip/*/*
!FPGA/FPGA.srcs/sources_1/ip/*/*.xci

# Local safety copies and editor/OS clutter
backup_before_codex_*/
.codex_qa/
.docx_review_*/
_local/
*.pid
~$*
.DS_Store
Thumbs.db
