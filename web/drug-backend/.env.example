# ============================================
# MolRecommender 后端环境配置示例 (v4.5)
# 复制为 .env 后按需填写
# ============================================

# 基础服务
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS 白名单（逗号分隔，本地开发必须包含前端地址）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://molrecommender.pages.dev

# LLM 服务配置（支持 OpenAI 兼容格式，如 DeepSeek / 通义千问 / Kimi / Ollama）
# 留空则自动进入 Mock 模式（适合本地开发）
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# LLM_MOCK_MODE 可选: auto(默认) / force_mock / force_real
LLM_MOCK_MODE=auto

# 加密配置
# 生产环境必须手动配置 32 字节 base64 编码的密钥
# 开发环境留空会自动生成（仅用于调试，不可用于生产）
ENCRYPTION_KEY=

# FPGA 配置
# 答辩电脑通过局域网访问 Z15 开发板
ENABLE_FPGA=true
FPGA_SERVICE_URL=http://192.168.1.10
FPGA_TCP_PORT=5001
# Model upload is explicit by default; set true only when startup may write to the board.
FPGA_AUTOLOAD_MODEL=false

# 数据库 / 缓存（当前版本使用文件存储，可留空）
DATABASE_URL=
REDIS_URL=

# 限流与容量
RATE_LIMIT_RPS=10.0
MAX_BODY_MB=10

# 日志（可选）
LOG_FILE=logs/molrec.log
